to complement your existing safety systems and controls.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h13l-3-3M20 17H7l3 3\"></path></svg></span>\n          <span class=\"m483246\">04</span>\n        </div>\n        <span class=\"m2d6cbd\">Replacement systems</span>\n        <span class=\"mc3fc4d\">Radio control systems designed to replace your existing control systems.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5\"></path></svg></span>\n          <span class=\"m483246\">05</span>\n        </div>\n        <span class=\"m2d6cbd\">Safety upgrades</span>\n        <span class=\"mc3fc4d\">Systems designed to upgrade your machine to meet current safety standards.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z\"></path></svg></span>\n          <span class=\"m483246\">06</span>\n        </div>\n        <span class=\"m2d6cbd\">Complete installation</span>\n        <span class=\"mc3fc4d\">The full scope of work, including electronics, hydraulics, pneumatics and mechanical installation.</span>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"7c329c7","elType":"container","isInner":false,"settings"