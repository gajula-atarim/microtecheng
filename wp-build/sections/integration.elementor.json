[{"id":"c641e22","elType":"container","isInner":false,"settings":{"_title":"01 Services Hero","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"6263921","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"m75245e mtp-hero\">\n  <div class=\"mbefb19\"><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span></div>\n  <div class=\"md6a7de\">\n    <div class=\"m350759\">\n      <div class=\"m40d029\">\n        <div class=\"m58aedf\"><a class=\"m892be7\" href=\"/\">Home</a><span>/</span><a class=\"m892be7\" href=\"/#services\">Our Services</a><span>/</span><span class=\"m8f2809\">System Integration</span></div>\n        <h1 class=\"m6f8485\">System Integration</h1>\n        <p class=\"m54d788\">Design and fitting of machine control systems. We integrate electronics and safety systems across your machine, from custom control electronics to radio remotes, load systems and crane safety systems.</p>\n      </div>\n      <div class=\"m1e56ad\"><img class=\"m0e7591\" src=\"https://microteceng.wsdfy.com/wp-content/uploads/2026/10/pexels-photo-31580848-scaled.jpeg\" alt=\"Machine control system integration\"></div>\n    </div>\n\n  </div></section></div>"},"elements":[]}]},{"id":"20aba40","elType":"container","isInner":false,"settings":{"_title":"02 Integration","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"803cfe7","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"mbdbf5b\">\n  <div class=\"md5e4d6\">\n    <div class=\"m3a688e\">\n      <div class=\"m5e01f3\">\n        <div class=\"md8d053\">What we design and fit</div>\n        <h2 class=\"m71bc66\">Machine control systems, designed and fitted</h2>\n      </div>\n      <p class=\"m21c823\">Every system is specified, fitted and calibrated by our engineers to suit your machine and your site.</p>\n    </div>\n    <div class=\"mc1ef13\">\n      <div class=\"m16698d mh8\">\n        <div class=\"ma60859\">\n          <span class=\"mf2879b\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3B479C\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 7h10v10H7zM10 3v4M14 3v4M10 17v4M14 17v4M3 10h4M3 14h4M17 10h4M17 14h4\"></path></svg></span>\n          <span class=\"m483246\">01</span>\n        </div>\n        <span class=\"m2d6cbd\">Customised machine control electronics</span>\n        <span class=\"m286bc1\">Custom electronic products and systems designed and manufactured for your machinery since 2007.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5\"></path></svg></span>\n          <span class=\"m483246\">02</span>\n        </div>\n        <span class=\"m2d6cbd\">Safety systems</span>\n        <span class=\"mc3fc4d\">Load monitoring, light control modules, warning lights, height limiting and alarm latching systems.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12.5a10 10 0 0 1 14 0M8 15.5a5.5 5.5 0 0 1 8 0M12 19h.01\"></path></svg></span>\n          <span class=\"m483246\">03</span>\n        </div>\n        <span class=\"m2d6cbd\">Radio remote control</span>\n        <span class=\"mc3fc4d\">Radio control to complement your existing safety systems and controls, or to replace them.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"></path></svg></span>\n          <span class=\"m483246\">04</span>\n        </div>\n        <span class=\"m2d6cbd\">Load systems</span>\n        <span class=\"mc3fc4d\">Weighing systems for front end loaders, excavators, forklifts and telescopic handlers.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h16M4 6h4v12H4zM16 6h4v12h-4zM10 9h4v6h-4z\"></path></svg></span>\n          <span class=\"m483246\">05</span>\n        </div>\n        <span class=\"m2d6cbd\">CanBus control systems</span>\n        <span class=\"mc3fc4d\">CanBus technology minimises wiring, increases reliability and makes troubleshooting simpler.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z\"></path></svg></span>\n          <span class=\"m483246\">06</span>\n        </div>\n        <span class=\"m2d6cbd\">Complete installation</span>\n        <span class=\"mc3fc4d\">The full scope of work, including electronics, hydraulics, pneumatics and mechanical installation.</span>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"ba10c12","elType":"container","isInner":false,"settings":{"_title":"03 Built for site","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"ab3681a","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"ma1032d\">\n    <div class=\"m5cba87\">\n      <div class=\"m83ad2c\"><span class=\"m2b2537\"></span><span class=\"m2b2537\"></span><span class=\"m2b2537\"></span></div>\n      <span class=\"m0659dc\">Robust, reliable and made to withstand harsh conditions.</span>\n      <p class=\"m0973e4\">Our experience in working with electronics used in plant and equipment has given our engineers the expertise to ensure that all designs are robust, reliable and made to withstand harsh conditions.</p>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"c945288","elType":"container","isInner":false,"settings":{"_title":"CTA","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"84b674f","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"medb174\">\n    <div class=\"mc602d2\">\n      <div class=\"m31ca0a\"><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span></div>\n      <div class=\"m4a6cf4\">\n        <span class=\"m4d81a6\">Need a machine control system designed and fitted?</span>\n        <span class=\"m7d9b41\">Call us to arrange an appointment to discuss your requirements.</span>\n      </div>\n      <div class=\"m4f30b6\">\n        <a class=\"me9eab3 mh7\" href=\"/#enquiry\">Contact Us \u2192</a>\n  