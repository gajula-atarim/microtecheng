" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h4l3-8 4 16 3-8h2\"></path></svg></span>\n          <span class=\"m96e1f4\">Dynamic and static systems are available.</span>\n        </div>\n        <div class=\"m0f4f6d\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z\"></path></svg></span>\n          <span class=\"m96e1f4\">Options such as printers and data management software are also available.</span>\n        </div>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"316efb1","elType":"container","isInner":false,"settings":{"_title":"CTA","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"0dffa0f","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"medb174\">\n    <div class=\"mc602d2\">\n      <div class=\"m31ca0a\"><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span></div>\n      <div class=\"m4a6cf4\">\n        <span class=\"m4d81a6\">Talk to us about loader weighing</span>\n        <span class=\"m7d9b41\">Feel free to contact our office for further information.</span>\n      </div>\n      <div class=\"m4f30b6\">\n        <a class=\"me9eab3 mh7\" href=\"/#enquiry\">Contact Us \u2192</a>\n        <span class=\"m9b34cf\">or call</span>\n        <a class=\"m0f60a8\" href=\"tel:0397922243\">03 9792 2243</a>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]}]