[{"id":"76f4a47","elType":"container","isInner":false,"settings":{"_title":"01 Services Hero","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"ec4729e","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"m75245e mtp-hero\">\n  <div class=\"mbefb19\"><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span></div>\n  <div class=\"md6a7de\">\n    <div class=\"m350759\">\n      <div class=\"m40d029\">\n        <div class=\"m58aedf\"><a class=\"m892be7\" href=\"/\">Home</a><span>/</span><a class=\"m892be7\" href=\"/#services\">Our Services</a><span>/</span><span class=\"m8f2809\">Design Services</span></div>\n        <h1 class=\"m6f8485\">Design Services</h1>\n        <p class=\"m54d788\">Since 2007 Microtec's engineers have been designing and manufacturing customised solutions for customer's machinery.</p>\n      </div>\n      <div class=\"m1e56ad\">\n        <div class=\"m1f2447\"><img class=\"m0e7591\" src=\"https://microteceng.wsdfy.com/wp-content/uploads/2026/10/pexels-photo-9242885.jpeg\" alt=\"Design Services photo\"></div><div class=\"mb4ad7f\"><img class=\"m0e7591\" src=\"https://microteceng.wsdfy.com/wp-content/uploads/2026/10/pexels-photo-38190066.jpeg\" alt=\"Electronic Repairs photo\" loading=\"lazy\"></div><div class=\"mb4ad7f\"><img class=\"m0e7591\" src=\"https://microteceng.wsdfy.com/wp-content/uploads/2026/10/pexels-photo-16100275.jpeg\" alt=\"Elevated Work Platform Control Systems (EWP) photo\" loading=\"lazy\"></div>\n      </div>\n    </div>\n\n  </div></section></div>"},"elements":[]}]},{"id":"a5d7aca","elType":"container","isInner":false,"settings":{"_title":"02 Design projects","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"10a1217","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"m0787aa\">\n    <div class=\"m51de31\">\n      <div class=\"md8d053\">Design and manufacture</div>\n      <h2 class=\"m71bc66\">Some of the products we have designed and manufactured include:</h2>\n      <p class=\"m1ca2d3\">Our clients have ranged from small one man operations to large multinationals.  Designs are often requested to solve specific site requirements or safety issues.</p>\n      <div class=\"m119a29\">\n        <svg class=\"md59f61\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3B479C\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6zM8.5 12l2.5 2.5 4.5-5\"></path></svg>\n        <p class=\"m12fd6b\">Our experience in working with electronics used in plant and equipment has given our engineers the expertise to ensure that all designs are robust, reliable and made to withstand harsh conditions.</p>\n      </div>\n    </div>\n    <div class=\"m61d522\">\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">01</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">GPS based geofence system</span><span class=\"md04055\">to prevent cranes from hitting power lines and other obstacles on a railway station construction site for McConnell Dowell.  The same system was also used in Sydney during construction works for their desalination plant.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">02</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Light control modules</span><span class=\"md04055\">to allow customers to easily interface the crane safety computer to external warning lights to alert personnel on site when the crane is operating near capacity or in alarm situations.  These modules have been installed on thousands of machines to meet crane safe requirements.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">03</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Jib stow detection systems</span><span class=\"md04055\">to alert operators of faults in storing a jib to the side of a crane to prevent jibs from accidentally falling off.  This was in response to a request from one of Boom Logistics' branches to solve a problem they had on a mining site.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">04</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">External LED warning lights</span><span class=\"md04055\">for cranes to satisfy crane safe requirements.  Designed to be long lasting and maintenance free in our harsh Australian conditions.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">05</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Height limiting systems</span><span class=\"md04055\">to prevent collision with overhead powerlines.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">06</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Crane alarm latching systems</span><span class=\"md04055\">designed for Thiess to comply with their OH &amp; S requirements.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">07</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Hi rail operating system</span><span class=\"md04055\">designed for a client to allow operators to correctly set up and pack up a vehicle's railway track guidance system by automating the operations and monitoring pressures on the hi rail tracks.</span></div>\n          </div>\n          <div class=\"mb0ca0d\">\n            <span class=\"mcb78bb\">08</span>\n            <div class=\"m7299c9\"><span class=\"md63603\">Design and fit Radio Remote Control Systems</span></div>\n          </div>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"967007b","elType":"container","isInner":false,"settings":{"_title":"CTA","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"cc540f3","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"medb174\">\n    <div class=\"mc602d2\">\n      <div class=\"m31ca0a\"><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span></div>\n      <div class=\"m4a6cf4\">\n        <span class=\"m4d81a6\">Have a site requirement or safety issue to solve?</span>\n        <span class=\"m7d9b41\">Feel free to contact our office for further information.</span>\n      </div>\n      <div class=\"m4f30b6\">\n        <a class=\"me9eab3 mh7\" href=\"/#enquiry\">Contact Us \u2192</a>\n        <span class=\"m9b34cf\">or call</span>\n        <a class=\"m0f60a8\" href=\"tel:0397922243\">03 9792 2243</a>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]}]