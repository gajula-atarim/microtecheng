[{"id":"0309aa5","elType":"container","isInner":false,"settings":{"_title":"01 Services Hero","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"b90577a","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"m75245e mtp-hero\">\n  <div class=\"mbefb19\"><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span><span class=\"m0069f5\"></span></div>\n  <div class=\"md6a7de\">\n    <div class=\"m350759\">\n      <div class=\"m40d029\">\n        <div class=\"m58aedf\"><a class=\"m892be7\" href=\"/\">Home</a><span>/</span><a class=\"m892be7\" href=\"/#services\">Our Services</a><span>/</span><a class=\"m892be7\" href=\"/services/load-systems/\">Load Systems</a><span>/</span><span class=\"m8f2809\">Crane Safety Systems</span></div>\n        <h1 class=\"m6f8485\">Crane Safety Systems</h1>\n        <p class=\"m54d788\">Specialist design and fitting of machine controlled systems. From load monitoring to warning lights and powerline protection, we help keep cranes, operators and sites safe.</p>\n      </div>\n      <div class=\"m1e56ad\"><img class=\"m0e7591\" src=\"https://microteceng.wsdfy.com/wp-content/uploads/2026/10/pexels-photo-33488902.jpeg\" alt=\"Crane fitted with Microtec safety system\"></div>\n    </div>\n\n  </div></section></div>"},"elements":[]}]},{"id":"e8fd14e","elType":"container","isInner":false,"settings":{"_title":"02 Crane safety","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"968d3a9","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"mbdbf5b\">\n  <div class=\"md5e4d6\">\n    <div class=\"m3a688e\">\n      <div class=\"m5e01f3\">\n        <div class=\"md8d053\">What we design and fit</div>\n        <h2 class=\"m71bc66\">Safety systems built around your crane</h2>\n      </div>\n      <p class=\"m21c823\">Every system is specified, fitted and calibrated by our engineers to suit your machine and your site.</p>\n    </div>\n    <div class=\"mc1ef13\">\n      <div class=\"m16698d mh8\">\n        <div class=\"ma60859\">\n          <span class=\"mf2879b\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3B479C\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3v3M5 21h14M7 21l5-12 5 12M4 9h16\"></path></svg></span>\n          <span class=\"m483246\">01</span>\n        </div>\n        <span class=\"m2d6cbd\">Load monitoring systems</span>\n        <span class=\"m286bc1\">Rated capacity and load monitoring so operators know exactly what the crane is lifting.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z\"></path></svg></span>\n          <span class=\"m483246\">02</span>\n        </div>\n        <span class=\"m2d6cbd\">Light control modules</span>\n        <span class=\"mc3fc4d\">Interface the crane safety computer to external warning lights to alert personnel when the crane is near capacity or in alarm.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 2v3M4.2 4.2l2.1 2.1M2 12h3M19 12h3M17.7 6.3l2.1-2.1M8 12a4 4 0 1 1 8 0v6H8z\"></path></svg></span>\n          <span class=\"m483246\">03</span>\n        </div>\n        <span class=\"m2d6cbd\">External LED warning lights</span>\n        <span class=\"mc3fc4d\">Long lasting, maintenance free lights built for harsh Australian conditions.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18M7 6v4M17 6v4M12 21V11M8 15l4-4 4 4\"></path></svg></span>\n          <span class=\"m483246\">04</span>\n        </div>\n        <span class=\"m2d6cbd\">Height limiting systems</span>\n        <span class=\"mc3fc4d\">Prevent collision with overhead powerlines.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20h16M6 20V8l6-4 6 4v12M10 12h4\"></path></svg></span>\n          <span class=\"m483246\">05</span>\n        </div>\n        <span class=\"m2d6cbd\">Jib stow detection</span>\n        <span class=\"mc3fc4d\">Alert operators to faults when stowing a jib, preventing it from accidentally falling off.</span>\n      </div>\n      <div class=\"mf9aa13 mh8\">\n        <div class=\"ma60859\">\n          <span class=\"md3f8d6\"><svg class=\"mc4771a\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4\"></path></svg></span>\n          <span class=\"m483246\">06</span>\n        </div>\n        <span class=\"m2d6cbd\">Alarm latching systems</span>\n        <span class=\"mc3fc4d\">Latch alarm events so they are acknowledged, supporting site OH&amp;S requirements.</span>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"cb9e69c","elType":"container","isInner":false,"settings":{"_title":"03 Built for site","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"cb061ec","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"ma1032d\">\n    <div class=\"m5cba87\">\n      <div class=\"m83ad2c\"><span class=\"m2b2537\"></span><span class=\"m2b2537\"></span><span class=\"m2b2537\"></span></div>\n      <span class=\"m0659dc\">Robust, reliable and made to withstand harsh conditions.</span>\n      <p class=\"m0973e4\">Our experience in working with electronics used in construction and mining equipment has given our engineers the expertise to ensure that all designs are robust, reliable and made to withstand harsh conditions.</p>\n    </div>\n  </div></section></div>"},"elements":[]}]},{"id":"cbeaa8c","elType":"container","isInner":false,"settings":{"_title":"CTA","content_width":"full","css_classes":"mtp-con","flex_gap":{"column":"0","row":"0","isLinked":true,"unit":"px","size":0},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"7e8a1db","elType":"widget","widgetType":"html","settings":{"html":"<div class=\"mtp\"><section class=\"ma2e621\">\n  <div class=\"medb174\">\n    <div class=\"mc602d2\">\n      <div class=\"m31ca0a\"><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span><span class=\"mcbbb19\"></span></div>\n      <div class=\"m4a6cf4\">\n        <span class=\"m4d81a6\">Need a safety system designed or fitted to your crane?</span>\n        <span class=\"m7d9b41\">Feel free to contact our office for further information.</span>\n      </div>\n      <div class=\"m4f30b6\">\n        <a class=\"me9eab3 mh7\" href=\"/#enquiry\">Contact Us \u2192</a>\n        <span class=\"m9b34cf\">or call</span>\n        <a class=\"m0f60a8\" href=\"tel:0397922243\">03 9792 2243</a>\n      </div>\n    </div>\n  </div></section></div>"},"elements":[]}]}]